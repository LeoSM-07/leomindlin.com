---
import "@/styles/global.css";
import { cn } from "@/lib/utils";
import { getCollection } from "astro:content";
import { Font } from "astro:assets";

const location = Astro.url.pathname;

const SiteTitle = location === "/" ? "h1" : "div";

const isPost = location.includes("/post/");

const links = {
	github: "https://github.com/LeoSM-07",
	twitter: "https://x.com/mindlin_xyz",
	linkedIn: "https://www.linkedin.com/in/leo-mindlin/",
};

const posts = await getCollection("posts");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Léo Mindlin</title>

		<Font cssVariable="--font-jetbrains-mono" />
		<Font cssVariable="--font-public-sans" preload />
	</head>
	<body
		hx-boost="true"
		class="mx-auto grid min-h-screen max-w-[800px] grid-rows-[auto_1fr_auto] space-y-4 px-4 pb-10 pt-20"
	>
		<header
			class={cn(
				"flex flex-row justify-between text-sm",
				!isPost && "border-b pb-4",
			)}
		>
			<SiteTitle>leomindlin.com</SiteTitle>

			{
				posts.length > 0 && (
					<nav class="space-x-4">
						<a class={cn(location == "/" && "text-accent")} href="/">
							home
						</a>
						<a class={cn(location == "/posts" && "text-accent")} href="/posts">
							posts
						</a>
					</nav>
				)
			}
		</header>
		<slot />

		<footer class="flex flex-row justify-between border-t pt-4 text-sm">
			<a target="_blank" href="mailto:hello@leomindlin.com"
				>hello@leomindlin.com</a
			>
			<div class="space-x-2">
				<a target="_blank" href={links.github}>GitHub</a>
				<a target="_blank" href={links.linkedIn}>LinkedIn</a>
				<a target="_blank" href={links.twitter}>Twitter</a>
			</div>
		</footer>
	</body>
</html>

<script>
	import "htmx.org";
</script>
