---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
	(a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime(),
);
---

<Layout>
	<main>
		<ol class="list-decimal pl-7">
			{
				posts.map((post) => (
					<li>
						<a class="flex w-full flex-col" href={`/post/${post.data.slug}`}>
							{post.data.title} <br />
							<span class="text-muted-foreground">
								Published {post.data.publishDate.toLocaleDateString()} •{" "}
								{
									(post.body + "" + post.data.description)
										.trim()
										.split(/\s+/)
										.filter((word) => word.length > 0).length
								}{" "}
								Words
							</span>
						</a>
					</li>
				))
			}
		</ol>
	</main>
</Layout>
