---
import Layout from "@/layouts/Layout.astro";

console.log(import.meta.env.MODE);
---

<Layout>
	<main class="space-y-4">
		<p>
			Studying Software Engineering at <a
				href="https://mcgill.ca/"
				target="_blank"
			>
				McGill University.</a
			>
			Usually between Los Angeles and Montreal.
		</p>

		<section>
			<h2 class="font-semibold">Current Occupations</h2>
			<ul class="list-inside list-disc pl-4">
				<li>
					Software Development Intern at <a
						target="_blank"
						href="https://botpress.com/">Botpress</a
					>
				</li>
				<li>
					Ground Station Project Lead at the <a
						target="_blank"
						href="https://mcgillrocketteam.com/">McGill Rocket Team</a
					>
				</li>
				<li>
					Bachelor of Engineering, Co-op in Software Engineering at <a
						target="_blank"
						href="https://mcgill.ca/">McGill University</a
					>
				</li>
			</ul>
		</section>
		<section>
			<h2 class="font-semibold">Prior Occupations</h2>
			<ul class="list-inside list-disc pl-4">
				<li>
					Web Design for the <a
						target="_blank"
						href="https://interstellarflight.space/"
						>McGill Interstellar Flight Experimental Research Group</a
					>
				</li>
				<li>
					Software Engineering Intern in Test at <a
						target="_blank"
						href="https://www.internetbrands.com/">Internet Brands</a
					>
				</li>
				<li>
					Freelance Web Design for <a
						target="_blank"
						href="https://tellavision.agency/">TellAVision Agency</a
					>
				</li>
			</ul>
		</section>
	</main>
</Layout>
